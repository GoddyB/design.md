{"style":{"id":"13b74e34-b824-4d1d-bd2c-bb9bfbc2d6e1","url":"https://spacex.com","siteName":"SpaceX","screenshotUrl":"https://images.refero.design/styles/refero.design/image/e3405be6-a005-4075-a262-15689b62bba2.jpg","thumbnailUrl":"https://images.refero.design/styles/refero.design/image/61b681ae-f26c-433e-ba0d-32b82967abeb.jpg","iconUrl":null,"previewVideoUrl":"https://images.refero.design/styles/refero.design/video/ac6688ce-e531-4ebf-b523-dbcd2d59f25a.mp4","previewVideoPosterUrl":"https://images.refero.design/styles/refero.design/image/3dbb0465-9c7e-4015-a080-9418cb8e5a01.jpg","previewVideoWidth":1200,"previewVideoHeight":750,"previewVideoDetailUrl":"https://images.refero.design/styles/refero.design/video/34c7ba25-c3eb-4c98-972d-cb01c26d9645.mp4","previewVideoDetailPosterUrl":"https://images.refero.design/styles/refero.design/image/8eca8d76-8271-41d4-a7b5-27abba488d0d.jpg","previewVideoDetailWidth":1600,"previewVideoDetailHeight":1000,"previewVideoDurationMs":11767,"previewVideoCapturedAt":"2026-06-05T01:14:05.054Z","colorScheme":"dark","industry":"other","createdAt":"2026-03-04T19:55:18.000Z","fullResult":{"meta":{"url":"https://spacex.com","siteName":"SpaceX","extractedAt":"2026-06-03T16:10:15.905Z","durationMs":25164,"viewport":{"width":1440,"height":900},"elementCount":190,"telemetry":{"enrichment":{"componentHtmlStatus":"complete","attempts":2}}},"raw":{"colors":{"tokens":[{"hex":"#f0f0fa","oklch":{"c":0.013333079384350407,"h":286.1453291270982,"l":0.9580221674377112},"contexts":["other","nav","body","heading","button","icon","image","footer"],"frequency":858,"confidence":1,"prominence":66388382.29843464,"properties":["color","borderColor","fill"],"usageCounts":{}},{"hex":"#000000","oklch":{"c":0,"h":0,"l":0},"contexts":["button","body","nav"],"frequency":22,"confidence":1,"prominence":6065757.31592575,"properties":["backgroundColor","color","borderColor"],"usageCounts":{}},{"hex":"#545457","oklch":{"c":0.005644268724815448,"h":286.16918850431597,"l":0.4471154