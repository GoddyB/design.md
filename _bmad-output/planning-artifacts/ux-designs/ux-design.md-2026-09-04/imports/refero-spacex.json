,"propertyContextPairs":[]},{"value":60,"contexts":[],"frequency":2,"properties":["marginRight","marginLeft"],"propertyContextPairs":[]}],"density":"comfortable","baseUnit":null},"gradients":[],"typography":{"fonts":[{"family":"D-DIN","source":"custom","weights":[400,700],"frequency":177,"fontFeatureSettings":[]},{"family":"D-DIN-Bold","source":"custom","weights":[400],"frequency":5,"fontFeatureSettings":[]}],"scale":{"base":16,"name":"Major Second","ratio":1.125,"confidence":1},"steps":[{"size":10,"family":"D-DIN","weight":400,"contexts":["nav"],"frequency":1,"lineHeight":0.94,"letterSpacing":0.1,"textTransform":"uppercase"},{"size":12,"family":"D-DIN","weight":400,"contexts":["other"],"frequency":5,"lineHeight":1,"letterSpacing":0,"textTransform":"uppercase"},{"size":12,"family":"D-DIN","weight":400,"contexts":["nav"],"frequency":5,"lineHeight":2,"letterSpacing":0,"textTransform":"uppercase"},{"size":13,"family":"D-DIN","weight":700,"contexts":["nav"],"frequency":28,"lineHeight":0.94,"letterSpacing":0.09,"textTransform":"uppercase"},{"size":13,"family":"D-DIN","weight":700,"contexts":["nav"],"frequency":2,"lineHeight":0.94,"letterSpacing":0.09,"textTransform":"none"},{"size":13,"family":"D-DIN","weight":400,"contexts":["button","nav"],"frequency":3,"lineHeight":1.2,"letterSpacing":0,"textTransform":"none"},{"size":16,"family":"D-DIN","weight":400,"contexts":["other","nav","body","button","icon","image","footer"],"frequency":111,"lineHeight":1.5,"letterSpacing":0,"textTransform":"none"},{"size":16,"family":"D-DIN","weight":400,"contexts":["nav"],"frequency":18,"lineHeight":0.94,"letterSpacing":0,"textTransform":"none"},{"size":16,"family":"D-DIN","weight":400,"contexts":["nav"],"frequency":4,"lineHeight":1.7,"letterSpacing":0,"textTransform":"none"},{"size":48,"family":"D-DIN-Bold","weight":400,"contexts":["heading"],"frequency":3,"lineHeight":1,"letterSpacing":0.02,"textTransform":"uppercase"},{"size":48,"family":"D-DIN-Bold","weight":400,"contexts":["heading"],"frequency":2,"lineHeight":1.25,"letterSpacing":0.02,"textTransform":"uppercase"}]}},"designSystem":{"dos":["Use #000000 as the canvas for every section; the page has no other background surface","Set all headlines at 48px in D-DIN-Bold uppercase with 0.02em tracking","Use uppercase D-DIN with 0.09-0.10em letter-spacing for every nav item, label, and button — tracking is non-negotiable","Build buttons as 1px outlined ghosts in #f0f0fa with 4px radius; never fill them","Let full-bleed photography carry the page; constrain text blocks to the left third of the viewport","Use 18px for element gaps and 60px for section vertical rhythm","Set body text at 13px with 1.7 line-height and 0.10em tracking — the wide tracking is the signature"],"donts":["Never introduce a chromatic accent color — the system is monochrome by design","Never use a filled button background; all actions are outlined","Never place text in a card, panel, or tinted container — type floats directly on photography or on black","Never use a border-radius above 4px for structural elements (32px is reserved for pill toggles only)","Never use a font with humanist or editorial warmth; the system demands industrial geometric type","Never add shadows, gradients, or glow effects — the page has zero elevation vocabulary","Never use a layout grid that fragments imagery; sections are always full-bleed and single-column"],"theme":"dark","colors":[{"hex":"#000000","name":"Void Black","role":"Page canvas, all section backgrounds — the unbroken dark that makes the photography luminous","group":"neutral"},{"hex":"#f0f0fa","name":"Star White","role":"All body text, headings, icons, nav labels, button text, button borders — the sole foreground color; the cool tint reads as artificial light against black, not paper","group":"neutral"},{"hex":"#545457","name":"Dim Steel","role":"Supporting neutral for secondary UI, dividers, and muted labels. Do not promote it to the primary CTA color","group":"neutral"},{"hex":"#404040","name":"Dark Gunmetal","role":"Subtle nav separators and low-emphasis dividers — barely visible against black, used only when structural separation is needed","group":"neutral"}],"layout":"Single-column full-bleed flow. There is no grid system, no card layout, no sidebar. The page stacks sections vertically, each section anchored by a viewport-width photograph with a text block floating in the left third. Navigation is a minimal horizontal bar at the top — logo left, nav links right, utility selector far right. Content blocks are left-aligned, never centered, and constrained to ~400-500px width. There are no alternating light/dark bands because the page is always dark. Section transitions are governed by the imagery itself: a Mars section dissolves into a rocket section dissolves into an Earth section, each separated by the full height of the viewport. Sticky behavior is minimal — the nav does not change appearance on scroll.","imagery":"Full-bleed cinematic photography is the design system. Every section is governed by a single high-resolution image: Mars at planetary scale, Starship on the launch pad at golden hour, the Falcon 9 booster descending through a sunset sky. Images are always raw-edged and full-viewport-width — no rounded corners, no contained cards, no overlaid frames. Photography is high-production, dramatic, and often shot at the warm-cool boundary of sunset or in the absolute black of space, which makes the off-white typography read as artificial instrument light against natural darkness. No illustrations, no product mockups, no icon systems — the rockets and planets ARE the icons. Density is image-dominant: each section devotes 80-100% of its visual real estate to a single photograph.","similar":[{"why":"Same cinematic dark-canvas approach with full-bleed spacecraft photography and minimal white technical typography","business":"NASA"},{"why":"Same parent-company restraint — monochrome dark interface, uppercase tracked nav, zero decorative color, photography as the primary visual element","business":"Tesla"},{"why":"Aerospace competitor with matching dark-mode cinematic photography aesthetic and minimal industrial typography","business":"Blue Origin"},{"why":"Same dark canvas + full-bleed rocket/space photography + minimal sans-serif overlay typography approach","business":"Virgin Galactic"},{"why":"Same monochrome dark-mode product storytelling with large uppercase headlines and ghost-outlined interactive elements","business":"Rivian"}],"spacing":{"radius":{"nav":"4px","pill":"32px","cards":"4px","buttons":"4px"},"elementGap":"18px","sectionGap":"60px","cardPadding":"20px","pageMaxWidth":null},"industry":"other","surfaces":[{"hex":"#000000","name":"Void","level":1,"purpose":"Base canvas — every section sits directly on black; there is no elevated card layer above the page"},{"hex":"#000000","name":"Image Bleed","level":2,"purpose":"Full-bleed photography composites with black letterboxing or fades; the image edge dissolves back into Void Black"}],"northStar":"Mission control viewport into deep space","typeScale":[{"role":"caption","size":10,"lineHeight":1.5},{"role":"body-sm","size":12,"lineHeight":1.5},{"role":"body","size":13,"lineHeight":1.5},{"role":"body-lg","size":16,"lineHeight":1.5}],"components":[{"name":"Ghost Outline Button","role":"Primary interactive element","description":"1px solid border in #f0f0fa, transparent fill, 4px radius. Text in #f0f0fa at 12-13px, uppercase, 0.10em letter-spacing, 700 weight. Padding 10-20px horizontal, 12-18px vertical. No filled variant exists. The outlined form against black creates a control-panel switch aesthetic."},{"name":"Secondary Outline Button","role":"De-emphasized action","description":"1px solid border in #545457, transparent fill, 4px radius. Same text specs as Ghost Outline Button but in #545457. Used for non-primary actions or disabled-adjacent states where the button should recede."},{"name":"Pill Button","role":"Pill-shaped action variant","description":"32px border-radius with same 1px outline and text treatment as the Ghost Outline Button. Reserved for compact selectors or tag-like actions where the rounded form signals a toggle rather than a navigation."},{"name":"Top Navigation Bar","role":"Primary site navigation","description":"Horizontal bar, transparent background over black, full viewport width. Logo left (SpaceX wordmark, white), nav links centered or right-aligned in D-DIN 10-12px, 700 weight, 0.09-0.10em tracking, uppercase. A secondary selector widget (launch countdown) sits at the far right with a 4px outlined border. No background fill, no shadow, no sticky backdrop blur — it sits naked on the void."},{"name":"Full-Bleed Hero Section","role":"Cinematic opening or section divider","description":"Viewport-width photograph (Mars, rocket launches, Earth from orbit) with no border-radius. Text block anchored in the left third of the viewport, vertically centered, with the 48px all-caps headline and 13px body paragraph floating directly over the image. No card, no panel, no background tint behind the text — only the contrast of white type on the dark portions of the photograph."},{"name":"Text-Over-Image Block","role":"Standard content section","description":"Same full-bleed image with text overlay pattern as the hero. The text block occupies roughly 30-35% of the viewport width on the left. No divider or border separates sections; they flow sequentially, each governed by its photograph."},{"name":"Section Headline","role":"Title element","description":"D-DIN-Bold, 48px, uppercase, 0.02em tracking, #f0f0fa. Line-height 1.0-1.25. Tight, solid mass. The headline is always the largest element on the page; nothing competes with it for scale."},{"name":"Body Paragraph","role":"Descriptive text","description":"D-DIN 13px, weight 400, 0.10em letter-spacing, #f0f0fa. Line-height 1.7. The wide tracking on body text is unusual — it reads as a label, not prose. Max width constrained to ~400-500px to keep line length readable."},{"name":"Launch Selector Widget","role":"Persistent utility in nav","description":"Outlined selector in the top-right navigation. 1px border in #f0f0fa, 4px radius, contains a small caret/chevron. Displays an uppercase tracked label. Functions as a dropdown anchor for upcoming launch information."}],"typography":[{"role":"Primary typeface for navigation, body, labels, buttons. The tracked-out uppercase (0.09–0.10em) at 10-13px turns every nav item and label into an instrument-panel abbreviation. D-DIN is an industrial geometric sans — its sharp terminals and even stroke weight read as engineered hardware typography, not editorial.","sizes":"10, 12, 13, 16","family":"D-DIN","weight":"400, 700","lineHeight":"1.0–2.0","substitute":"Barlow (free, closest match in geometry and industrial feel), then DIN Next Condensed","letterSpacing":"0.09em at 10px, 0.10em at 12-16px","fontFeatureSettings":"\"tnum\" on, \"ss01\" on"},{"role":"Section headlines — set in ALL CAPS at 48px with 0.02em tracking. The bold weight is reserved exclusively for headlines; the minimal tracking (compared to the 0.10em on nav) tightens the headline mass and lets it feel solid, not scattered. This is the loudest element on any screen.","sizes":"48","family":"D-DIN-Bold","weight":"400","lineHeight":"1.0–1.25","substitute":"Barlow Bold (free), then DIN Next LT Pro Bold","letterSpacing":"0.02em at 48px"}],"description":"SpaceX operates in cinematic darkness. The entire interface is a single voice — off-white technical typography on absolute black — with no decorative color to compete with the full-bleed photography of spacecraft and celestial bodies. D-DIN, a geometric industrial sans, gives every label the feel of an instrument panel readout; uppercase tracking at 0.09-0.10em turns navigation into mission-control abbreviations. The page surrenders its visual real estate to imagery: text floats over rockets and planets rather than sitting in contained cards. Buttons are hairline outlines, never filled. Color appears only as a function of light — the page has no accent, no warm, no soft.","customSections":[{"title":"Agent Prompt Guide","content":"**Quick Color Reference**\n- text: #f0f0fa\n- background: #000000\n- border: #f0f0fa (primary) / #545457 (secondary)\n- accent: none\n- primary action: no distinct CTA color\n\n**Example Component Prompts**\n\n1. *Full-bleed hero with text overlay:* Black canvas (#000000) with a viewport-width photograph. Headline: D-DIN-Bold, 48px, uppercase, #f0f0fa, letter-spacing 0.02em, line-height 1.0. Body text: D-DIN, 13px, weight 400, #f0f0fa, letter-spacing 0.10em, line-height 1.7, max-width 450px. Text block positioned in the left third of the viewport, vertically centered. No background panel behind text.\n\n2. *Ghost outline button:* 1px solid border in #f0f0fa, transparent background, 4px border-radius. Text: D-DIN, 12px, 700 weight, uppercase, #f0f0fa, letter-spacing 0.10em. Padding: 10px 20px. Optional right-arrow icon in same color and weight.\n\n3. *Top navigation bar:* Full viewport width, transparent background, no shadow. Logo (white wordmark) at far left. Nav links: D-DIN, 10-12px, 700 weight, uppercase, #f0f0fa, letter-spacing 0.09-0.10em, 18px column-gap. Launch selector widget at far right: 1px #f0f0fa border, 4px radius, same text treatment.\n\n4. *Body paragraph block:* D-DIN, 13px, weight 400, #f0f0fa, letter-spacing 0.10em, line-height 1.7. No paragraph indentation. Max-width 500px. Place directly on black or on the dark portion of a photograph."},{"title":"Typography as Instrument Panel","content":"The 0.09-0.10em letter-spacing on all non-headline text is the system's most opinionated choice. It transforms every label, nav item, and button from prose into an instrument readout — a design vocabulary borrowed from aerospace HUD displays and engineering schematics, not from editorial or marketing typography. The tracking must never be reduced; it IS the brand voice at small sizes. Headlines at 48px drop to 0.02em because at display scale the tracking would feel decorative rather than functional."}],"elevationPhilosophy":"The design has no elevation system. There are no shadows, no drop shadows, no glows, no blur effects. Depth is created entirely through full-bleed photography rather than through z-axis layering. Interactive states (button hover) are communicated through border opacity or a subtle background fill, never through shadows."},"screenshot":{"url":"https://images.refero.design/styles/refero.design/image/e3405be6-a005-4075-a262-15689b62bba2.jpg","thumbnail":"https://images.refero.design/styles/refero.design/image/61b681ae-f26c-433e-ba0d-32b82967abeb.jpg"}}},"similar":[{"id":"e8c604cc-1c8d-42a3-aeca-fcfc25e70344","url":"https://astro.build","siteName":"Astro","screenshotUrl":"https://images.refero.design/styles/refero.design/image/eb8a15e9-6299-49fc-bd0b-95582fcfaea1.jpg","thumbnailUrl":"https://images.refero.design/styles/refero.design/image/320baf97-42f1-44ee-b997-42cd8b910955.jpg","iconUrl":null,"previewVideoUrl":"https://images.refero.design/styles/refero.design/video/ecb4859d-7d10-40a2-8756-bf9f06df9d5e.mp4","previewVideoPosterUrl":"https://images.refero.design/styles/refero.design/image/69eae8a0-918d-44c5-aed4-36ca1b52d615.jpg","previewVideoWidth":1200,"previewVideoHeight":750,"previewVideoDetailUrl":"https://images.refero.design/styles/refero.design/video/a7f50124-13c5-4b3f-acaf-6a4abef39886.mp4","previewVideoDetailPosterUrl":"https://images.refero.design/styles/refero.design/image/01af1277-ba6a-4a47-ba98-e689fe734c2c.jpg","previewVideoDetailWidth":1600,"previewVideoDetailHeight":1000,"previewVideoDurationMs":18500,"colorScheme":"dark","colors":[{"name":"Void Canvas","hex":"#1f232e"},{"name":"Abyss","hex":"#0c0f19"},{"name":"Singularity","hex":"#060913"},{"name":"Carbon","hex":"#17191e"},{"name":"Lunar White","hex":"#f2f6fa"},{"name":"Platinum","hex":"#e5e7eb"}],"fonts":["ui-sans-serif","Obviously","ui-monospace","MDIO","Inter"],"northStar":"De